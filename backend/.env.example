# Copier ce fichier en backend/.env pour modifier les réglages (sinon ces valeurs par défaut s'appliquent).
# Chemins relatifs = relatifs à la RACINE du projet. Tout reste sur ce PC.

APP_HOST=127.0.0.1                # jamais 0.0.0.0 : application locale uniquement (refusé par la config)
APP_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=sqlite:///./data/movieshazam.db
MEDIA_ROOT=./data/media
TEMP_ROOT=./data/temp

# --- empreintes (changer FPS crée une nouvelle version d'index : pas de mélange) ---
FINGERPRINT_VERSION=phash-v1
FINGERPRINT_FPS=2                 # images/s indexées (intervalle entier en ms requis : 1, 2, 4, 5, 10...)
QUERY_OVERSAMPLING=5              # le clip est échantillonné 5x plus finement (10 img/s), même pHash
SEGMENT_DURATION_SECONDS=180      # longueur MAXIMALE d'un segment (unité de travail CPU)
MIN_SEGMENT_SECONDS=10            # longueur minimale
TARGET_MIN_SEGMENTS=8             # un film court est quand même découpé en >= 8 segments
SEGMENT_OVERLAP_MS=0              # pré-lecture optionnelle aux frontières (images écartées ensuite)
FFMPEG_THREADS=1                  # threads internes de CHAQUE FFmpeg (évite la sursouscription)

# --- concurrence locale (paramètres initiaux, pas des performances garanties) ---
PROCESS_WORKERS=2                 # processus du pool (calcul CPU). Tester 1, 2, 4 avec la page Performances
IO_THREADS=2                      # threads pour les E/S bloquantes (copie, SHA-256, ffprobe, vignettes)
MAX_ACTIVE_INDEX_JOBS=1           # indexations simultanées
MAX_ACTIVE_SEARCH_JOBS=2          # recherches simultanées
MAX_QUEUED_JOBS=32                # taille de la file d'attente bornée
MAX_INFLIGHT_SEGMENTS_PER_WORKER=2

# --- limites ---
MIN_QUERY_DURATION_SECONDS=4
MAX_QUERY_DURATION_SECONDS=30
MAX_UPLOAD_GB=8
MAX_CLIP_UPLOAD_MB=300

# Facultatif : chemins explicites si FFmpeg n'est pas dans le PATH
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BINARY=C:\ffmpeg\bin\ffprobe.exe
